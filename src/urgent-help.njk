<h2>Urgent help when your GP practice is closed</h2>
<p><strong>Call <a href="tel:111">111</a></strong> for NHS 24. <a href="https://www.nhs24.scot/111/">Read about the 111 service</a>.</p>
<h2>Health information</h2>
<p>Visit <a href="https://www.nhsinform.scot/">NHS inform</a> for health information and services in Scotland.</p>
{% else %}
{{ card({
  variant: "emergency",
